# Public — exposed to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=

# AI — prefer Vercel AI Gateway. Falls back to direct provider keys.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRO=

# Email
RESEND_API_KEY=
RESEND_FROM=Interia <noreply@interia.app>

# WhatsApp notifications via UAZAPI (optional, reuses existing infra)
UAZAPI_URL=
UAZAPI_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_KEY=

# Sentry (optional, run `npx @sentry/wizard@latest -i nextjs` to set up)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PDF (optional, dev)
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
